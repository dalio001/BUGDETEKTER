# Postgres connection
DATABASE_URL=postgres://bugdetekter:bugdetekter@127.0.0.1:5432/bugdetekter

# HTTP server
PORT=4000
HOST=0.0.0.0

# Secrets — set real random values in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-jwt-secret
SIGNING_SECRET=change-me-signing-secret

# Set to "true" when serving over HTTPS so auth cookies are Secure
COOKIE_SECURE=false

# Comma-separated origins allowed to make credentialed API calls. Leave empty
# when the dashboard is served from this same backend (the default). Only set
# this if you host the dashboard on a separate origin, e.g.
# CORS_ORIGINS=https://dashboard.example.com
# (The public /api/ingest endpoint is always open to any origin, without credentials.)
CORS_ORIGINS=

# Attachment storage: "local" (default) or "s3"
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads

# Only needed when STORAGE_DRIVER=s3 (works with AWS S3 or MinIO)
# S3_BUCKET=bugdetekter
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=true

# Used by scripts/seed.ts for the initial admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
