# Keep the build context small and free of secrets.
# Without this, `COPY . .` bakes the host's node_modules (~175MB) and — critically —
# backend/.env with real secrets into the image.

# Dependencies: reinstalled in the image via `npm ci`
node_modules
**/node_modules

# Secrets and local config
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Build output: regenerated in the image via `npm run build`
dist
**/dist

# Local runtime data (uploaded screenshots live in a volume, not the image)
data
**/data

# VCS and CI metadata
.git
.gitignore
.github

# Test / tooling artifacts
playwright-report
test-results
**/*.log
coverage

# Editor / OS noise
.vscode
.idea
.DS_Store

# Docs and container files aren't needed at runtime
Dockerfile
.dockerignore
docker-compose.yml
